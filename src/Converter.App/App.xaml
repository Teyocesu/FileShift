<Application x:Class="FileShift.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#0B0D11" />
        <SolidColorBrush x:Key="BgSurface" Color="#12161E" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#1F2633" />
        <SolidColorBrush x:Key="AccentPrimary" Color="#14B8A6" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F5F9" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
    </Application.Resources>
</Application>
