<Window x:Class="FileShift.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileShift — Convertidor Universal de Archivos"
        Width="1040" Height="680" MinWidth="760" MinHeight="520"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="18">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                    <TextBlock Text="FileShift" FontSize="20" FontWeight="Bold" Margin="6,4,0,18" />
                    <Button x:Name="BtnNavActivity" Content="Actividad" Click="BtnNavActivity_Click" HorizontalContentAlignment="Left" Padding="12,9" Background="#1E293B" Foreground="White" BorderThickness="0" />
                    <Button x:Name="BtnNavAutomations" Content="Automatizaciones" Click="BtnNavAutomations_Click" HorizontalContentAlignment="Left" Padding="12,9" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" />
                    <Button x:Name="BtnNavSettings" Content="Configuración &amp; Menú" Click="BtnNavSettings_Click" HorizontalContentAlignment="Left" Padding="12,9" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#0F172A" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="100% Gratuito y Local" FontWeight="SemiBold" FontSize="12" Foreground="#2DD4BF" />
                        <TextBlock Text="Sin cuentas · Sin nube · Sin límites" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Width="*" Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Actividad" FontSize="24" FontWeight="Bold" />
                    <TextBlock x:Name="TxtHeaderSub" Text="Arrastrá archivos aquí o convertí con clic derecho desde Windows Explorer" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox x:Name="CmbTargetFormat" Width="120" SelectedIndex="0" Margin="0,0,10,0" Padding="8,6">
                        <ComboBoxItem Content="webp" />
                        <ComboBoxItem Content="jpeg" />
                        <ComboBoxItem Content="png" />
                        <ComboBoxItem Content="avif" />
                        <ComboBoxItem Content="mp4" />
                        <ComboBoxItem Content="webm" />
                        <ComboBoxItem Content="gif" />
                        <ComboBoxItem Content="mp3" />
                        <ComboBoxItem Content="wav" />
                        <ComboBoxItem Content="flac" />
                        <ComboBoxItem Content="pdf" />
                    </ComboBox>
                    <Button Content="+ Añadir archivos" Click="BtnAddFiles_Click" Padding="16,8" Background="#14B8A6" Foreground="#042F2E" FontWeight="SemiBold" BorderThickness="0" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16">
                <ListBox x:Name="LstJobs" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" />
            </Border>
        </Grid>
    </Grid>
</Window>
