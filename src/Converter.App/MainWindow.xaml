<Window x:Class="FileShift.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileShift — Convertidor Universal de Archivos (Windows 11)"
        Width="1160" Height="740" MinWidth="900" MinHeight="600"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="18">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="FileShift" FontSize="21" FontWeight="Bold" Margin="6,4,0,4" />
                    <TextBlock Text="Windows 11 Local Converter" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="6,0,0,18" />

                    <Button x:Name="BtnNavActivity" Content="Actividad y Cola" Click="BtnNavActivity_Click" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,6" Background="#1E293B" Foreground="White" BorderThickness="0" />
                    <Button x:Name="BtnNavAutomations" Content="Automatizaciones" Click="BtnNavAutomations_Click" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,6" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" />
                    <Button x:Name="BtnNavGeneral" Content="Configuración General" Click="BtnNavGeneral_Click" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,6" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" />
                    <Button x:Name="BtnNavMenu" Content="Menú Contextual Win11" Click="BtnNavMenu_Click" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,6" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" />
                    <Button x:Name="BtnNavPresets" Content="Presets de Conversión" Click="BtnNavPresets_Click" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,6" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#0F172A" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="100% Gratuito · Open Source MIT" FontWeight="SemiBold" FontSize="12" Foreground="#2DD4BF" />
                        <TextBlock Text="Sin cuentas · Sin telemetría · Escritura atómica verificada con SHA-256" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Actividad y Cola de Conversión" FontSize="23" FontWeight="Bold" />
                    <TextBlock x:Name="TxtHeaderSub" Text="Arrastrá archivos aquí o convertí con clic derecho desde el Explorador de Windows 11" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCompatibilityHint" Text="Formatos compatibles: Todos" VerticalAlignment="Center" Foreground="#2DD4BF" FontSize="12" Margin="0,0,14,0" />
                    <Button Content="+ Añadir archivos…" Click="BtnAddFiles_Click" Padding="16,8" Background="#14B8A6" Foreground="#042F2E" FontWeight="SemiBold" BorderThickness="0" />
                </StackPanel>
            </DockPanel>

            <!-- VIEW 1: ACTIVITY -->
            <Grid x:Name="ViewActivity" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Conversion Options Bar -->
                <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="Destino:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}" />
                            <ComboBox x:Name="CmbTargetFormat" Width="115" Padding="6,4" />
                            <Button x:Name="BtnConvertSelection" Content="Convertir selección" Margin="8,0,0,0" Padding="8,4" Click="BtnConvertSelection_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}" />
                            <ComboBox x:Name="CmbPreset" Width="170" Padding="6,4" SelectionChanged="CmbPreset_SelectionChanged" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="Calidad (1-100):" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}" />
                            <TextBox x:Name="TxtQuality" Width="52" Text="85" Padding="6,4" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="Lado máx (px):" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}" />
                            <TextBox x:Name="TxtLongestEdge" Width="68" Text="" ToolTip="Vacío = tamaño original" Padding="6,4" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="Págs PDF:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}" />
                            <TextBox x:Name="TxtPageRange" Width="64" Text="" ToolTip="Vacío = todas (ej: 1-3)" Padding="6,4" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <CheckBox x:Name="ChkStripMetadata" Content="Limpiar EXIF" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" Margin="0,0,8,4" />
                    </WrapPanel>
                </Border>

                <!-- Jobs List -->
                <Border Grid.Row="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <ListBox x:Name="LstJobs" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" />
                </Border>

                <!-- Job Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Cancelar trabajo seleccionado" Click="BtnCancelJob_Click" Padding="12,7" Margin="0,0,10,0" Background="#334155" Foreground="White" BorderThickness="0" />
                    <Button Content="Reintentar trabajo" Click="BtnRetryJob_Click" Padding="12,7" Margin="0,0,10,0" Background="#1E293B" Foreground="White" BorderThickness="0" />
                    <Button Content="Abrir archivo convertido" Click="BtnOpenOutput_Click" Padding="12,7" Margin="0,0,10,0" Background="#1E293B" Foreground="White" BorderThickness="0" />
                    <Button Content="Mostrar en carpeta" Click="BtnOpenFolder_Click" Padding="12,7" Margin="0,0,10,0" Background="#1E293B" Foreground="White" BorderThickness="0" />
                    <Button Content="Limpiar finalizados" Click="BtnClearCompleted_Click" Padding="12,7" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" />
                </StackPanel>
            </Grid>

            <!-- VIEW 2: AUTOMATIONS -->
            <Grid x:Name="ViewAutomations" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Activar / Desactivar regla seleccionada" Click="BtnToggleRule_Click" Padding="12,7" Margin="0,0,10,0" Background="#14B8A6" Foreground="#042F2E" FontWeight="SemiBold" BorderThickness="0" />
                            <Button Content="Eliminar regla" Click="BtnDeleteRule_Click" Padding="12,7" Background="#334155" Foreground="White" BorderThickness="0" />
                        </StackPanel>
                        <ListBox x:Name="LstAutomations" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Nueva regla de vigilancia de carpeta (FileSystemWatcher)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Nombre de regla" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtRuleName" Width="190" Text="Capturas -> WebP" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Carpeta vigilada" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtRuleFolder" Width="260" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Filtro (ej: *.png;*.jpg)" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtRuleFilter" Width="130" Text="*.png;*.jpg" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Convertir a" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbRuleTargetFormat" Width="100" Padding="6,4" />
                            </StackPanel>
                            <ComboBox x:Name="CmbRulePreset" Width="145" VerticalAlignment="Bottom" Margin="0,0,14,12" />
                            <CheckBox x:Name="ChkRuleCopyClipboard" Content="Copiar resultado" VerticalAlignment="Bottom" Margin="0,0,14,12" Foreground="{StaticResource TextPrimary}" />
                            <Button Content="Guardar regla" Click="BtnAddRule_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" Padding="14,6" Background="#14B8A6" Foreground="#042F2E" FontWeight="SemiBold" BorderThickness="0" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- VIEW 3: GENERAL SETTINGS & DOCTOR -->
            <Grid x:Name="ViewSettingsGeneral" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Preferencias de Salida y Rendimiento" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,20,8">
                                <TextBlock Text="Política ante archivos existentes" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbConflictPolicy" Width="290" Padding="6,4">
                                    <ComboBoxItem Content="AutoRename — Crear archivo (1).ext sin sobrescribir" Tag="AutoRename" />
                                    <ComboBoxItem Content="Overwrite — Reemplazar solo tras validar salida" Tag="Overwrite" />
                                    <ComboBoxItem Content="Skip — Omitir si ya existe un destino" Tag="Skip" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,8">
                                <TextBlock Text="Carpeta de salida (vacío = junto al original)" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtCustomOutputDir" Width="280" Padding="6,4" />
                            </StackPanel>

                            <StackPanel Margin="0,0,20,8">
                                <TextBlock Text="Trabajos simultáneos (Concurrencia)" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbConcurrency" Width="130" Padding="6,4">
                                    <ComboBoxItem Content="2 hilos" Tag="2" />
                                    <ComboBoxItem Content="4 hilos" Tag="4" />
                                    <ComboBoxItem Content="8 hilos" Tag="8" />
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox x:Name="ChkShowNotifications" Content="Mostrar notificación al finalizar" Foreground="{StaticResource TextPrimary}" Margin="0,0,22,6" />
                            <CheckBox x:Name="ChkRevealInExplorer" Content="Revelar en Windows Explorer al terminar" Foreground="{StaticResource TextPrimary}" Margin="0,0,22,6" />
                            <CheckBox x:Name="ChkKeepInBackground" Content="Mantener en bandeja del sistema (System Tray)" Foreground="{StaticResource TextPrimary}" Margin="0,0,22,6" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Guardar Configuración General" Click="BtnSaveGeneralSettings_Click" Padding="14,7" Margin="0,0,12,0" Background="#14B8A6" Foreground="#042F2E" FontWeight="SemiBold" BorderThickness="0" />
                            <Button Content="Ejecutar Diagnóstico de Motores (Doctor)" Click="BtnRunDoctor_Click" Padding="14,7" Background="#1E293B" Foreground="White" BorderThickness="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Estado de Motores Locales (FFmpeg · ImageMagick · Ghostscript · LibreOffice)" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox x:Name="LstDoctorResults" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- VIEW 4: WINDOWS 11 CONTEXT MENU SETTINGS -->
            <Grid x:Name="ViewSettingsMenu" Grid.Row="1" Visibility="Collapsed">
                <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <CheckBox x:Name="ChkEnableContextMenu" Content="Habilitar 'Convertir a…' en el menú contextual de clic derecho de Windows 11 (IExplorerCommand)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Categoría de archivo:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextMuted}" />
                                <ComboBox x:Name="CmbMenuCategory" Width="160" Padding="6,4" SelectionChanged="CmbMenuCategory_SelectionChanged">
                                    <ComboBoxItem Content="Image" />
                                    <ComboBoxItem Content="SVG" />
                                    <ComboBoxItem Content="Video" />
                                    <ComboBoxItem Content="Audio" />
                                    <ComboBoxItem Content="PDF" />
                                    <ComboBoxItem Content="Document" />
                                </ComboBox>
                                <TextBlock Text="Agregar formato favorito:" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{StaticResource TextMuted}" />
                                <ComboBox x:Name="CmbAddFavoriteFormat" Width="110" Padding="6,4" Margin="0,0,8,0" />
                                <Button Content="+ Añadir a favoritos" Click="BtnAddFavoriteFormat_Click" Padding="10,5" Background="#1E293B" Foreground="White" BorderThickness="0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Subir prioridad" Click="BtnMoveFavUp_Click" Padding="12,7" Margin="0,0,8,0" Background="#1E293B" Foreground="White" BorderThickness="0" />
                            <Button Content="Bajar prioridad" Click="BtnMoveFavDown_Click" Padding="12,7" Margin="0,0,8,0" Background="#1E293B" Foreground="White" BorderThickness="0" />
                            <Button Content="Quitar seleccionado" Click="BtnRemoveFav_Click" Padding="12,7" Margin="0,0,16,0" Background="#334155" Foreground="White" BorderThickness="0" />
                            <Button Content="Guardar y Sincronizar menu-cache.json" Click="BtnSaveMenuSettings_Click" Padding="14,7" Background="#14B8A6" Foreground="#042F2E" FontWeight="SemiBold" BorderThickness="0" />
                        </StackPanel>

                        <ListBox x:Name="LstMenuFavorites" Background="#0B0D11" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Foreground="{StaticResource TextPrimary}" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- VIEW 5: PRESETS -->
            <Grid x:Name="ViewSettingsPresets" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Eliminar preset seleccionado" Click="BtnDeletePreset_Click" Padding="12,7" Background="#334155" Foreground="White" BorderThickness="0" />
                        </StackPanel>
                        <ListBox x:Name="LstPresets" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Crear nuevo Preset reutilizable (disponible en GUI y CLI --preset)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Nombre del Preset" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtPresetName" Width="190" Text="Web Optimizado" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Formato destino" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbPresetTarget" Width="105" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Calidad (1-100)" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtPresetQuality" Width="80" Text="82" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Lado máximo (px)" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtPresetEdge" Width="110" Text="1920" Padding="6,4" />
                            </StackPanel>
                            <CheckBox x:Name="ChkPresetStripMeta" Content="Limpiar metadatos" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,14,12" Foreground="{StaticResource TextPrimary}" />
                            <Button Content="Guardar Preset" Click="BtnSavePreset_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" Padding="14,6" Background="#14B8A6" Foreground="#042F2E" FontWeight="SemiBold" BorderThickness="0" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="10,6" Background="#0F172A" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6">
                <TextBlock x:Name="TxtStatusBar" Text="Listo — Configuración sincronizada con %LOCALAPPDATA%\FileShift\settings.json" FontSize="12" Foreground="#94A3B8" />
            </Border>
        </Grid>
    </Grid>
</Window>
